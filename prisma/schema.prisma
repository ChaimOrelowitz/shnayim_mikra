// Prisma schema for Shnayim Mikra Tracker
// Phase 1: Tracking only, no Torah text storage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Parsha {
  id        String   @id @default(cuid())
  name      String   // Hebrew name (e.g., "בראשית")
  order     Int      @unique
  aliyos    Aliyah[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Aliyah {
  id       String  @id @default(cuid())
  parshaId String
  parsha   Parsha  @relation(fields: [parshaId], references: [id], onDelete: Cascade)
  number   Int     // 1-7
  pdfPath  String? // Optional uploaded PDF
  
  // Aliyah-level tracking
  done     Boolean @default(false)
  mikra1   Boolean @default(false)
  mikra2   Boolean @default(false)
  targum   Boolean @default(false)
  
  pesukim  Pasuk[]

  @@unique([parshaId, number])
}

model Pasuk {
  id       String  @id @default(cuid())
  aliyahId String
  aliyah   Aliyah  @relation(fields: [aliyahId], references: [id], onDelete: Cascade)
  perek    Int     // Perek number
  pasuk    Int     // Pasuk number
  
  // Pasuk-level tracking (same as Aliyah)
  done     Boolean @default(false)
  mikra1   Boolean @default(false)
  mikra2   Boolean @default(false)
  targum   Boolean @default(false)

  @@unique([aliyahId, perek, pasuk])
}
