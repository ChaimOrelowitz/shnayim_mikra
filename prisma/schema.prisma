// Prisma schema for Shnayim Mikra Tracker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Location {
  CHUL
  EY
}

enum ParshaType {
  SINGLE
  COMBINED
}

enum ViewMode {
  CLASSIC
  READER
}

model Profile {
  id            String   @id // matches Supabase auth.users UUID
  email         String   @unique
  firstName     String?
  lastName      String?
  role          Role     @default(USER)
  location      Location @default(CHUL)
  preferredView ViewMode @default(CLASSIC)
  createdAt     DateTime @default(now())

  aliyahProgress UserAliyahProgress[]
  pasukProgress  UserPasukProgress[]
}

model Parsha {
  id          String     @id @default(cuid())
  name        String
  englishName String?
  order       Float      @unique
  type        ParshaType @default(SINGLE)
  aliyos      Aliyah[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Aliyah {
  id       String  @id @default(cuid())
  parshaId String
  parsha   Parsha  @relation(fields: [parshaId], references: [id], onDelete: Cascade)
  number   Int     // 1-7
  pdfPath  String? // Admin-managed PDF

  pesukim      Pasuk[]
  userProgress UserAliyahProgress[]

  @@unique([parshaId, number])
}

model Pasuk {
  id          String  @id @default(cuid())
  aliyahId    String
  aliyah      Aliyah  @relation(fields: [aliyahId], references: [id], onDelete: Cascade)
  perek       Int
  pasuk       Int
  hebrewText  String  @default("")
  targumText  String?

  rashiComments RashiComment[]
  userProgress  UserPasukProgress[]

  @@unique([aliyahId, perek, pasuk])
}

model RashiComment {
  id              String  @id @default(cuid())
  pasukId         String
  pasuk           Pasuk   @relation(fields: [pasukId], references: [id], onDelete: Cascade)
  sortOrder       Int
  dibburHamaschil String?
  text            String

  @@index([pasukId])
}

model UserAliyahProgress {
  id         String  @id @default(cuid())
  userId     String
  user       Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  aliyahId   String
  aliyah     Aliyah  @relation(fields: [aliyahId], references: [id], onDelete: Cascade)
  hebrewYear Int     @default(5786)

  done         Boolean @default(false)
  mikra1       Boolean @default(false)
  mikra2       Boolean @default(false)
  targum       Boolean @default(false)
  rashiReview  Boolean @default(false)

  @@unique([userId, aliyahId, hebrewYear])
}

model UserPasukProgress {
  id         String  @id @default(cuid())
  userId     String
  user       Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  pasukId    String
  pasuk      Pasuk   @relation(fields: [pasukId], references: [id], onDelete: Cascade)
  hebrewYear Int     @default(5786)

  done   Boolean @default(false)
  mikra1 Boolean @default(false)
  mikra2 Boolean @default(false)
  targum Boolean @default(false)

  @@unique([userId, pasukId, hebrewYear])
}
